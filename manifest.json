{
  "manifest_version": 3,
  "name": "skip.",
  "version": "1.2.0",
  "description": "Automatically skips skippable YouTube ads.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}