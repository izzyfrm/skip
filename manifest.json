{
  "manifest_version": 3,
  "name": "Enhance",
  "version": "1.0.0",
  "description": "Automatically enhances YouTube videos with a simple before & after comparison.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}